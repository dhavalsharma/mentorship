# Copy to .env (gitignored) and fill in. Nothing in this repo should ever hold
# a real token — see docs/live-tenant-testing.md before setting any of these.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mentorship
ORG_ID=
# The Postgres role apps/api and apps/worker connect as. Leave unset to use
# the connection's own role (a superuser locally, which bypasses RLS); name
# the unprivileged `mentorship_app` role here once one exists, so RLS is
# actually enforced rather than just present.
TENANT_ROLE=

# Anthropic — powers the real primitives (session intelligence, matching's
# adjudication, nudge planning) when set. Every primitive still works
# without it: runPrimitive degrades to its deterministic fallback path.
ANTHROPIC_API_KEY=

# Slack — from a sandbox workspace's app, never a production one.
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# Google — a test-account OAuth credential, against a dedicated secondary
# calendar. Never a service account with domain-wide delegation for this
# purpose; that can impersonate anyone in the domain.
#
# Two ways to authenticate, and prefer the second one: a bare
# GOOGLE_ACCESS_TOKEN expires in about an hour with no way back except
# redoing the OAuth Playground exchange by hand every time. Set the three
# GOOGLE_CLIENT_*/GOOGLE_REFRESH_TOKEN vars instead and the app refreshes its
# own access token automatically (packages/integrations/src/google/auth.ts) —
# GOOGLE_ACCESS_TOKEN is then unused and can stay blank. See README for how
# to get a refresh token from the same Playground flow (it's the same
# exchange, plus two checkboxes).
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# The running shared doc, one per pair. Optional — unset, the document slot
# stays on the fake. A folder URL or a bare id works for either. Drive/Docs
# need scopes Calendar does not: documents + drive.file (see README).
# An integration_bindings row for the org (the dashboard's Shared document
# page) takes precedence over both of these.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_GUIDELINE_DOC_ID=

# Sign-in and invite email through the Gmail API (docs/email-setup.md). Setting
# GMAIL_SENDER_ADDRESS turns sending on for `pnpm serve:api`; leave it unset and
# links are printed to the log instead. Needs a refresh token that includes the
# https://www.googleapis.com/auth/gmail.send scope, and APP_BASE_URL (https
# unless localhost) for the link. Calendar invitations are unrelated.
GMAIL_SENDER_ADDRESS=
GMAIL_SENDER_NAME=
GMAIL_REPLY_TO=
APP_BASE_URL=
# Seconds between sign-in (or invite) mails to one address; default 60, 0 = off.
# MAGIC_LINK_EMAIL_COOLDOWN_SECONDS=60

# Comma-separated emails and chat member ids SandboxGuard will allow. Anything
# else is refused before it leaves the process — see packages/integrations/src/sandbox.ts.
# WARNING: this also gates sign-in/invite email from `serve:api` (everyone not on
# the list is silently refused). It must be UNSET in production.
# SANDBOX_ALLOWLIST=dhavals+mentor@wekancode.com,dhavals+mentee@wekancode.com

PORT=8787
WORKER_INTERVAL_MS=1000

# For `pnpm seed:live-pair` only — creates one pair to click through live.
MENTOR_EMAIL=dhavals+mentor@wekancode.com
MENTOR_SLACK_ID=
MENTOR_NAME=Mentor
MENTEE_EMAIL=dhavals+mentee@wekancode.com
MENTEE_SLACK_ID=
MENTEE_NAME=Mentee
