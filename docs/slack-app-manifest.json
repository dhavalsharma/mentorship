{
  "display_information": {
    "name": "Mentorship Sandbox",
    "description": "Live-tenant test bot for the mentorship kernel — never install this in a production workspace."
  },
  "features": {
    "bot_user": {
      "display_name": "mentorship-sandbox",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "im:write", "mpim:write"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://REPLACE-WITH-YOUR-TUNNEL/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
