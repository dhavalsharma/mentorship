{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@mentorship/core": ["packages/core/src/index.ts"],
      "@mentorship/db": ["packages/db/src/index.ts"],
      "@mentorship/db/testing": ["packages/db/src/testing.ts"],
      "@mentorship/events": ["packages/events/src/index.ts"],
      "@mentorship/workflows": ["packages/workflows/src/index.ts"],
      "@mentorship/workflows/postgres": ["packages/workflows/src/postgres.ts"],
      "@mentorship/integrations": ["packages/integrations/src/index.ts"],
      "@mentorship/roster": ["packages/roster/src/index.ts"],
      "@mentorship/testkit": ["packages/testkit/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"]
}
