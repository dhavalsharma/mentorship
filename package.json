{
  "name": "mentorship",
  "private": true,
  "version": "0.1.0",
  "description": "A multi-tenant kernel for running mentor-mentee programs, with AI primitives as swappable contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx apps/worker/src/demo.ts",
    "serve:api": "tsx apps/api/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:matching-invariants": "vitest run packages/primitives/matching/src/__tests__/invariants.test.ts",
    "test:contracts:live": "tsx tests/contracts/live/preflight.ts && vitest run --config vitest.contracts.config.ts",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate-cli.ts",
    "serve:worker": "tsx apps/worker/src/main.ts",
    "dev:web": "pnpm --filter @mentorship/web dev",
    "serve:worker:live": "tsx apps/worker/src/main-live.ts",
    "seed:live-pair": "tsx apps/worker/src/seed-live-pair.ts",
    "deps:check": "depcruise --config .dependency-cruiser.cjs packages apps"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dependency-cruiser": "18.3.1",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  }
}
