# Origin of the real apps/api server this app proxies /api/* to (see
# next.config.ts's rewrites()). Defaults to http://localhost:8787, which is
# what `pnpm serve:api` listens on.
API_ORIGIN=http://localhost:8787

# The single org this dashboard reads. Must match the ORG_ID apps/api and
# apps/worker are configured for.
ORG_ID=00000000-0000-0000-0000-000000000000
